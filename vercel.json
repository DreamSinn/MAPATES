{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api", "destination": "/api/index.ts?route=/api" },
    { "source": "/api/:path*", "destination": "/api/index.ts?route=/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
